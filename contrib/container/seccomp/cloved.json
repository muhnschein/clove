        "exit_group",
        "faccessat",
        "faccessat2",
        "fallocate",
        "fchmod",
        "fchmodat",
        "fcntl",
        "flock",
        "fstat",
        "fsync",
        "ftruncate",
        "futex",
        "futex_waitv",
        "getdents64",
        "getpid",
        "getppid",
        "getrandom",
        "getsockname",
        "getsockopt",
        "gettid",
        "gettimeofday",
        "ioctl",
        "landlock_add_rule",
