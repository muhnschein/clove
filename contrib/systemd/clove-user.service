# Per-user clove service, for running clove as yourself with the XDG defaults.
#
# Install:
#   install -Dm 0644 contrib/systemd/clove-user.service \
#       ~/.config/systemd/user/clove.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now clove
#
# With no clove.conf, this uses ~/.local/share/clove for state and
# $XDG_RUNTIME_DIR/clove.sock for the control socket, so `clove` finds the
# daemon with no arguments.
#
# NOTE ON SANDBOXING. The IPAddressDeny=/IPAddressAllow= filters in the
# system unit (contrib/systemd/clove.service) are cgroup BPF filters that the
# *system* manager applies. In a user manager they are silently ineffective
# unless your distribution delegates the net cgroup controller to user slices,
# which most do not. They are therefore omitted here rather than left in place
# to give false comfort. The directives below do work per-user.
#
# If you want the kernel-enforced clearnet lock, use the system unit, or the
# network-namespace recipe in contrib/netns/README.md. clove remains I2P-only
# by construction either way (SCOPE §5, Layer 1); Layer 3 is defence in depth.

[Unit]
Description=clove, an I2P-only BitTorrent daemon
Documentation=man:clove(1) man:clove.conf(5) man:clove-api(7) man:cloved(8)
After=default.target

[Service]
Type=exec
ExecStart=%h/.local/bin/cloved
Restart=on-failure
RestartSec=5s

# Filesystem: reachable state only.
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=%h/.local/share/clove
ProtectProc=invisible

# Privilege.
NoNewPrivileges=yes
RestrictSUIDSGID=yes

# Kernel and process surface.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @debug @swap
SystemCallErrorNumber=EPERM
# See the system unit: if cloved's startup line reports its own Layer-2
# sandbox as not applied, this filter is missing systemd's @sandbox group
# (the seccomp and landlock_* syscalls) — add SystemCallFilter=@sandbox.

LimitNOFILE=8192
TasksMax=1024

[Install]
WantedBy=default.target
