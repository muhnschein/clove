# System-wide clove service (Layer 3 of the no-clearnet defence, SCOPE §5).
#
# `make install` puts this in place with @BINDIR@ and @SYSCONFDIR@ filled in,
# for a system prefix; a prefix under $HOME gets contrib/systemd/user instead.
#
#   sudo make install PREFIX=/usr/local
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now clove
#
# By hand, without make:
#
#   sed -e 's|@BINDIR@|/usr/local/bin|' -e 's|@SYSCONFDIR@|/etc|' \
#       contrib/systemd/system/clove.service \
#       | sudo tee /etc/systemd/system/clove.service
#
# The daemon needs no privilege beyond its own state directory and the router's
# SAM port, so it runs as a dedicated system user created by DynamicUser= with
# a persistent StateDirectory. Point clove.conf's data_dir at that directory:
#
#   # @SYSCONFDIR@/clove/clove.conf
#   data_dir /var/lib/clove
#   api_socket /run/clove/clove.sock
#
# Layer 3 is a belt-and-braces sandbox. clove is already I2P-only by
# construction (Layer 1) and does not rely on this unit being present — but
# when it is, the kernel enforces the same promise independently.

[Unit]
Description=clove, an I2P-only BitTorrent daemon
Documentation=man:clove(1) man:clove.conf(5) man:clove-api(7) man:cloved(8)
After=network.target i2pd.service
Wants=i2pd.service

[Service]
Type=exec
ExecStart=@BINDIR@/cloved -c @SYSCONFDIR@/clove/clove.conf
Restart=on-failure
RestartSec=5s

# Identity and state. DynamicUser gives a per-service uid; StateDirectory and
# RuntimeDirectory are created with the right ownership on every start.
DynamicUser=yes
StateDirectory=clove
StateDirectoryMode=0700
RuntimeDirectory=clove
RuntimeDirectoryMode=0755
# The daemon chmods the files that matter; this covers the rest.
UMask=0077

# --- The clearnet lock ---
# clove may speak to loopback (the SAM bridge) and nothing else. Unavailable to
# the user unit — systemd offers it to system services only — which is the main
# reason to prefer this one.
IPAddressDeny=any
IPAddressAllow=localhost
# AF_UNIX for the control socket, AF_INET for the loopback SAM connection.
RestrictAddressFamilies=AF_UNIX AF_INET

# --- Filesystem ---
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/clove
# Config is read once at start and never written.
ReadOnlyPaths=@SYSCONFDIR@/clove
# NoExecPaths= on the download tree is deliberately absent: DynamicUser= makes
# the state directory a symlink into /var/lib/private, and a namespace that
# fails to set up is a service that does not start.

# --- Privilege ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=yes
RestrictSUIDSGID=yes

# --- Kernel and process surface ---
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @debug @swap @cpu-emulation @raw-io
# EPERM here, ENOSYS in the daemon's own filter: @system-service is broad and
# long-tested, cloved's list is short and hand-maintained. See sandbox.rs.
SystemCallErrorNumber=EPERM
# cloved also restricts itself after start-up (Layer 2, cloved(8) SECURITY).
# That needs the seccomp and landlock_* syscalls, which live in systemd's
# @sandbox group. Recent systemd folds @sandbox into @system-service; if the
# daemon's startup line reports the sandbox as not applied under this unit,
# add:
#   SystemCallFilter=@sandbox
# Layer 2 failing here costs Layer 2 only — the unit's own restrictions and
# Layer 1 are unaffected.

# --- Resources ---
# clove is thread-per-peer; the default file limit is ample for I2P swarm
# sizes, but pin something explicit rather than inherit a surprise.
LimitNOFILE=8192
TasksMax=1024
# No core dumps: the address space holds the destination key and the API token.
LimitCORE=0

[Install]
WantedBy=multi-user.target
