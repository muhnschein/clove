# Per-user clove service, for running clove as yourself with the XDG defaults.
#
# `make install PREFIX="$HOME/.local"` puts this file in place with @BINDIR@
# filled in; a system prefix gets contrib/systemd/system/clove.service instead.
#
#   make install PREFIX="$HOME/.local"
#   systemctl --user daemon-reload
#   systemctl --user enable --now clove
#
# By hand, without make:
#
#   sed 's|@BINDIR@|'"$HOME"'/.local/bin|' contrib/systemd/user/clove.service \
#       > ~/.config/systemd/user/clove.service
#
# With no clove.conf, this uses ~/.local/share/clove for state and
# $XDG_RUNTIME_DIR/clove.sock for the control socket, so `clove` finds the
# daemon with no arguments.
#
# HOW THIS DIFFERS FROM THE SYSTEM UNIT, AND WHY IT IS NOT ONE FILE.
#
# A user manager cannot enforce two of the things the system unit does. The
# trap is that it does not refuse them either: both degrade *quietly*, so a
# unit that asked for them would start, look healthy, and enforce neither.
#
#   * The clearnet lock. IPAddressDeny=/IPAddressAllow= are cgroup BPF filters,
#     and systemd.resource-control(5) says the functionality "is currently only
#     available for system services, not for per-user services". A user manager
#     logs "unit configures an IP firewall, but not running as root" — once per
#     boot, for the first such unit on the system, and at debug level in a
#     container — then starts the service with every packet allowed. Omitted
#     here rather than left in place to give exactly that false comfort. **If
#     you want the kernel-enforced clearnet lock, use the system unit.**
#
#   * Filesystem namespacing. ProtectSystem=, ProtectHome=, PrivateTmp=,
#     PrivateDevices=, ProtectProc=, ProtectKernel*= and ReadWritePaths= need a
#     mount namespace, which an unprivileged manager cannot unshare.
#     systemd.exec(5) says these "are not available, as the underlying kernel
#     functionality is only accessible to privileged processes. However, most
#     namespacing settings ... will work when used in conjunction with
#     PrivateUsers=true." Not available does not mean refused: for settings
#     that only make things read-only or invisible, systemd logs at *debug*
#     level ("Failed to set up namespace, assuming containerized execution and
#     ignoring") and runs the service unconfined. Recent versions first try an
#     implicit user namespace, so on a host permitting unprivileged user
#     namespaces they may genuinely apply — and on one that does not, nothing
#     above debug tells you they did not.
#
# So the block at the bottom of this file is commented out, and the
# PrivateUsers=yes at the top of it is the part that matters: setting it
# explicitly is the fail-closed switch. A user namespace that cannot then be
# established is EXIT_USER — status=217/USER, service does not start — instead
# of a log notice and a service that runs with none of this applied.
#
# Two files rather than one because the system-only settings cannot be made
# conditional inside a unit: DynamicUser=, StateDirectory=, and the
# @SYSCONFDIR@ config path. DynamicUser= also decides the question above — it
# is one of the settings for which an un-unshareable mount namespace is fatal
# rather than ignorable, so the system unit really would not start here.
#
# Everything left active below needs neither privilege nor a namespace: it is
# seccomp and resource limits, which a user manager applies in full. clove
# remains I2P-only by construction (Layer 1) and self-restricting (Layer 2)
# either way; Layer 3 is defence in depth.

[Unit]
Description=clove, an I2P-only BitTorrent daemon
Documentation=man:clove(1) man:clove.conf(5) man:clove-api(7) man:cloved(8)
After=default.target

[Service]
Type=exec
ExecStart=@BINDIR@/cloved
Restart=on-failure
RestartSec=5s
UMask=0077

# --- Privilege ---
NoNewPrivileges=yes
RestrictSUIDSGID=yes

# --- Kernel and process surface (seccomp; no privilege required) ---
# AF_UNIX for the control socket, AF_INET for the loopback SAM connection.
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @debug @swap @cpu-emulation @raw-io
SystemCallErrorNumber=EPERM
# See the system unit: if cloved's startup line reports its own Layer-2
# sandbox as not applied, this filter is missing systemd's @sandbox group
# (the seccomp and landlock_* syscalls) — add SystemCallFilter=@sandbox.

# --- Resources ---
LimitNOFILE=8192
TasksMax=1024
# No core dumps: the address space holds the destination key and the API token.
LimitCORE=0

# --- Filesystem namespacing, opt-in ---
# Uncomment as a block, PrivateUsers= included: it is what makes the rest work
# in a user manager (systemd.exec(5), quoted above), and what makes a failure
# to do so visible instead of a debug line. If the service then refuses to
# start with status=217/USER, this host does not permit unprivileged user
# namespaces — comment the block out again and accept that these lines were
# doing nothing anyway.
#PrivateUsers=yes
#ProtectSystem=strict
#ProtectHome=read-only
#ReadWritePaths=%h/.local/share/clove
#PrivateTmp=yes
#PrivateDevices=yes
#ProtectProc=invisible
#ProcSubset=pid
#ProtectKernelTunables=yes
#ProtectKernelModules=yes
#ProtectKernelLogs=yes
#ProtectControlGroups=yes
#ProtectClock=yes
#ProtectHostname=yes
#PrivateIPC=yes

[Install]
WantedBy=default.target
