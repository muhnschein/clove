# Per-user clove service, for running clove as yourself with the XDG defaults.
#
# `make install PREFIX="$HOME/.local"` puts this file in place with @BINDIR@
# filled in; a system prefix gets contrib/systemd/system/clove.service instead.
#
#   make install PREFIX="$HOME/.local"
#   systemctl --user daemon-reload
#   systemctl --user enable --now clove
#
# By hand, without make:
#
#   sed 's|@BINDIR@|'"$HOME"'/.local/bin|' contrib/systemd/user/clove.service \
#       > ~/.config/systemd/user/clove.service
#
# With no clove.conf, this uses ~/.local/share/clove for state and
# $XDG_RUNTIME_DIR/clove.sock for the control socket, so `clove` finds the
# daemon with no arguments.
#
# HOW THIS DIFFERS FROM THE SYSTEM UNIT, AND WHY IT IS NOT ONE FILE.
#
# A user manager cannot enforce two of the things the system unit does, and
# systemd does not degrade quietly when asked for them — a namespace it cannot
# set up is a service that does not start, not a service that starts with less.
#
#   * The clearnet lock. IPAddressDeny=/IPAddressAllow= are cgroup BPF filters,
#     and systemd.resource-control(5) says the functionality "is currently only
#     available for system services, not for per-user services". They are
#     omitted here rather than left in place to give false comfort. **If you
#     want the kernel-enforced clearnet lock, use the system unit.**
#
#   * Filesystem namespacing. systemd.exec(5): "the various settings requiring
#     file system namespacing support (such as ProtectSystem=) are not
#     available, as the underlying kernel functionality is only accessible to
#     privileged processes. However, most namespacing settings, that will not
#     work on their own in user services, will work when used in conjunction
#     with PrivateUsers=true." That block is at the bottom of this file,
#     commented out, because PrivateUsers= needs unprivileged user namespaces
#     to be permitted and several distributions (Ubuntu 24.04 among them)
#     restrict them by default. Uncomment it if yours does not.
#
# Everything left active below needs neither privilege nor a namespace: it is
# seccomp and resource limits, which a user manager applies in full. clove
# remains I2P-only by construction (Layer 1) and self-restricting (Layer 2)
# either way; Layer 3 is defence in depth.

[Unit]
Description=clove, an I2P-only BitTorrent daemon
Documentation=man:clove(1) man:clove.conf(5) man:clove-api(7) man:cloved(8)
After=default.target

[Service]
Type=exec
ExecStart=@BINDIR@/cloved
Restart=on-failure
RestartSec=5s
UMask=0077

# --- Privilege ---
NoNewPrivileges=yes
RestrictSUIDSGID=yes

# --- Kernel and process surface (seccomp; no privilege required) ---
# AF_UNIX for the control socket, AF_INET for the loopback SAM connection.
# No AF_INET6: the SAM backend dials 127.0.0.1 by construction, and the
# daemon's own filter stopped permitting it.
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @debug @swap @cpu-emulation @raw-io
SystemCallErrorNumber=EPERM
# See the system unit: if cloved's startup line reports its own Layer-2
# sandbox as not applied, this filter is missing systemd's @sandbox group
# (the seccomp and landlock_* syscalls) — add SystemCallFilter=@sandbox.

# --- Resources ---
LimitNOFILE=8192
TasksMax=1024
# No core dumps: the address space holds the destination key and the API token.
LimitCORE=0

# --- Filesystem namespacing, opt-in ---
# Uncomment as a block. PrivateUsers= is what makes the rest work in a user
# manager (systemd.exec(5), quoted above); without it they are not available
# here, and with it they need unprivileged user namespaces to be permitted. If
# the service then fails to start with status=226/NAMESPACE, that is what is
# missing — comment the block out again.
#PrivateUsers=yes
#ProtectSystem=strict
#ProtectHome=read-only
#ReadWritePaths=%h/.local/share/clove
#PrivateTmp=yes
#PrivateDevices=yes
#ProtectProc=invisible
#ProcSubset=pid
#ProtectKernelTunables=yes
#ProtectKernelModules=yes
#ProtectKernelLogs=yes
#ProtectControlGroups=yes
#ProtectClock=yes
#ProtectHostname=yes
#PrivateIPC=yes

[Install]
WantedBy=default.target
