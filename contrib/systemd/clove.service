# System-wide clove service (Layer 3 of the no-clearnet defence, SCOPE §5).
#
# Install:
#   install -m 0644 contrib/systemd/clove.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now clove
#
# The daemon needs no privilege beyond its own state directory and the router's
# SAM port, so it runs as a dedicated system user created by DynamicUser= with
# a persistent StateDirectory. Point clove.conf's data_dir at that directory:
#
#   # /etc/clove/clove.conf
#   data_dir /var/lib/clove
#   api_socket /run/clove/clove.sock
#
# Layer 3 is a belt-and-braces sandbox. clove is already I2P-only by
# construction (Layer 1) and does not rely on this unit being present — but
# when it is, the kernel enforces the same promise independently.

[Unit]
Description=clove, an I2P-only BitTorrent daemon
Documentation=man:cloved(8) man:clove.conf(5)
# The router is a separate service; clove tolerates it being absent or
# restarting, so this is ordering only, not a hard dependency.
After=network.target i2pd.service
Wants=i2pd.service

[Service]
Type=exec
ExecStart=/usr/local/bin/cloved -c /etc/clove/clove.conf
Restart=on-failure
RestartSec=5s

# Identity and state. DynamicUser gives a per-service uid; StateDirectory and
# RuntimeDirectory are created with the right ownership on every start.
DynamicUser=yes
StateDirectory=clove
StateDirectoryMode=0700
RuntimeDirectory=clove
RuntimeDirectoryMode=0755

# --- The clearnet lock ---
# clove may speak to loopback (the SAM bridge) and nothing else. If a leak-class
# bug ever existed, this is where the kernel stops it.
IPAddressDeny=any
IPAddressAllow=localhost
# AF_UNIX for the control socket, AF_INET/AF_INET6 for the loopback SAM
# connection. Nothing else — no packet sockets, no netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# --- Filesystem ---
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/clove
# Config is read once at start and never written.
ReadOnlyPaths=/etc/clove

# --- Privilege ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=yes
RestrictSUIDSGID=yes

# --- Kernel and process surface ---
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @debug @swap
SystemCallErrorNumber=EPERM
# cloved also restricts itself after start-up (Layer 2, cloved(8) SECURITY).
# That needs the seccomp and landlock_* syscalls, which live in systemd's
# @sandbox group. Recent systemd folds @sandbox into @system-service; if the
# daemon's startup line reports the sandbox as not applied under this unit,
# add:
#   SystemCallFilter=@sandbox
# Layer 2 failing here costs Layer 2 only — the unit's own restrictions and
# Layer 1 are unaffected.

# --- Resources ---
# clove is thread-per-peer; the default file limit is ample for I2P swarm
# sizes, but pin something explicit rather than inherit a surprise.
LimitNOFILE=8192
TasksMax=1024

[Install]
WantedBy=multi-user.target
