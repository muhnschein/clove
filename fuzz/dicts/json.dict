# JSON as the CLI reads it back from the daemon. The target asserts a round
# trip, so the tokens that matter are the ones where encode and decode could
# disagree: escapes, number edges, and nesting.
"{"
"}"
"["
"]"
":"
","
"\""
"{}"
"[]"
"{\"a\":0}"
"[[]]"
"{\"\":\"\"}"

"null"
"true"
"false"

# Number edges: the i64/u64 boundaries the Value enum distinguishes, float
# overflow to infinity, and the syntactic forms a hand-rolled parser tends to
# get wrong.
"0"
"-0"
"-0.0"
"00"
"01"
"1e400"
"-1e400"
"1e308"
"1e-400"
"9223372036854775807"
"-9223372036854775808"
"18446744073709551615"
"18446744073709551616"
"1.7976931348623157e308"
".5"
"5."
"1e"
"1e+"
"+1"

# Escapes, including the surrogate pairs and the control characters that
# encode must escape and decode must accept.
"\\\""
"\\\\"
"\\/"
"\\b"
"\\f"
"\\n"
"\\r"
"\\t"
"\\u0000"
"\\u001f"
"\\u007f"
"\\uD800"
"\\uDC00"
"\\uD800\\uDC00"
"\\uFFFF"
"\\x"
"\\u"

# Raw control bytes and non-UTF-8, which a parser must reject rather than
# round-trip.
"\x00"
"\x09"
"\x1f"
"\x7f"
"\xc0\x80"
"\xff"
